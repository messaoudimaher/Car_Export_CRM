# ==============================================================================
# Multi-Stage Production Dockerfile for Frontend Static Asset Build (TASK-2101)
# Security Hardening: Non-root Nginx user (UID 10001), minimal Alpine base image.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Build Stage
# ------------------------------------------------------------------------------
FROM node:20-alpine AS builder

WORKDIR /app

# Copy package manifests
COPY src/frontend/package.json src/frontend/package-lock.json ./

# Install npm dependencies deterministically
RUN npm ci

# Copy frontend application source code
COPY src/frontend/ ./

# Build production static bundle (Vite outputs to /app/dist)
RUN npm run build

# ------------------------------------------------------------------------------
# Stage 2: Production Nginx Runtime
# ------------------------------------------------------------------------------
FROM nginx:1.25-alpine AS runtime

# Create unprivileged non-root system user and group (UID/GID 10001)
RUN addgroup -g 10001 nginxgroup && \
    adduser -u 10001 -G nginxgroup -s /bin/sh -D nginxuser

# Copy security-hardened non-root Nginx configuration
COPY docker/nginx.conf /etc/nginx/nginx.conf

# Copy production compiled static assets from builder stage
COPY --from=builder /app/dist /usr/share/nginx/html

# Grant ownership of Nginx paths to unprivileged non-root user (UID 10001)
RUN chown -R 10001:10001 /usr/share/nginx/html /tmp /var/cache/nginx /var/log/nginx /etc/nginx

# Switch to unprivileged non-root user (SEC-001)
USER 10001:10001

EXPOSE 8080

# Container liveness health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget --quiet --tries=1 --spider http://localhost:8080/health || exit 1

# Default command: Nginx Server
CMD ["nginx", "-g", "daemon off;"]
