# ==============================================================================
# Multi-Stage Production Dockerfile for Backend API & ARQ Worker (TASK-2101)
# Security Hardening: Non-root user (UID 10001), minimal slim image base.
# ==============================================================================

# ------------------------------------------------------------------------------
# Stage 1: Dependency Builder
# ------------------------------------------------------------------------------
FROM python:3.13-slim AS builder

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_SYSTEM_PYTHON=0

# Install uv package manager from official image
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

WORKDIR /app

# Copy dependency configuration files
COPY src/backend/pyproject.toml src/backend/uv.lock src/backend/README.md /app/

# Install production dependencies into virtualenv /app/.venv
RUN uv sync --frozen --no-dev --no-editable

# ------------------------------------------------------------------------------
# Stage 2: Minimal Production Runtime
# ------------------------------------------------------------------------------
FROM python:3.13-slim AS runtime

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PATH="/app/.venv/bin:$PATH" \
    PORT=8000

# Create unprivileged non-root system user and group (UID/GID 10001)
RUN groupadd -g 10001 appgroup && \
    useradd -u 10001 -g appgroup -s /bin/false -m appuser

WORKDIR /app

# Copy virtualenv dependencies from builder stage
COPY --from=builder --chown=10001:10001 /app/.venv /app/.venv

# Copy backend application source code
COPY --chown=10001:10001 src/backend /app

# Create storage directory for local attachments/PDF caching
RUN mkdir -p /app/storage && chown -R 10001:10001 /app/storage

# Switch to unprivileged non-root user (SEC-001)
USER 10001:10001

EXPOSE 8000

# Container liveness health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://localhost:8000/health/live')" || exit 1

# Default command: FastAPI Uvicorn Server
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
