# Environment & Logging
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_NAME=Car-Export-CRM

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://car_export_app:local_dev_password@localhost:5432/car_export_crm
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Authentication Secrets (Required in production)
JWT_SECRET=dev_jwt_secret_key_change_me_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# External Integration Secrets (Placeholders for future tasks)
META_WEBHOOK_APP_SECRET=dev_meta_app_secret_placeholder
LLM_PROVIDER_API_KEY=dev_llm_key_placeholder
OBJECT_STORAGE_BUCKET=car-export-crm-dev-storage
