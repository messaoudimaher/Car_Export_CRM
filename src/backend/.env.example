# General Application Settings
APP_NAME=Car-Export-CRM
ENVIRONMENT=development
LOG_LEVEL=INFO
DEBUG=false

# Database Configuration (PostgreSQL + asyncpg)
DATABASE_URL=postgresql+asyncpg://car_export_app:local_dev_password@localhost:5432/car_export_crm
DATABASE_MIGRATOR_URL=postgresql+asyncpg://car_export_migrator:local_migrator_password@localhost:5432/car_export_crm
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# Security & Authentication Secrets (Must be changed in production, min 32 chars)
JWT_SECRET=dev_jwt_secret_key_change_me_in_production_min_32_bytes_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Meta WhatsApp Webhook Credentials
META_WEBHOOK_APP_SECRET=dev_meta_app_secret_placeholder
META_WEBHOOK_VERIFY_TOKEN=dev_meta_verify_token_placeholder

# AI / LLM Provider Integration Credentials
LLM_PROVIDER=openai
LLM_PROVIDER_API_KEY=dev_llm_key_placeholder
EMBEDDING_PROVIDER_API_KEY=dev_embedding_key_placeholder

# Object Storage Credentials (S3 / MinIO)
OBJECT_STORAGE_BUCKET=car-export-crm-dev-storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=dev_s3_key_id_placeholder
S3_SECRET_ACCESS_KEY=dev_s3_secret_access_key_placeholder
